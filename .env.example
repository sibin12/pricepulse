# PricePulse API settings.
#
# Copy this file to .env (same folder) and fill in what you need:
#   cp .env.example .env && chmod 600 .env
# .env holds secrets: never commit it or share it. Everything is optional;
# the defaults shown work for local development. Real environment variables
# override values in .env (e.g. `ADDR=:9000 go run ./cmd/api`).

# --- Server & database ---
# DATABASE_URL=postgres://postgres:postgres@localhost:5433/pricepulse?sslmode=disable
# ADDR=:8088
# Web app address: used for CORS, redirects after Google sign-in, and email links.
# CORS_ORIGIN=http://localhost:3000
# APP_URL=http://localhost:3000

# --- Accounts ---
# Set to true when the site is served over HTTPS.
# COOKIE_SECURE=false

# Google sign-in: create an OAuth client ID (type "Web application") at
# https://console.cloud.google.com/apis/credentials and add the redirect URI below
# to its "Authorized redirect URIs". Leave empty to show only email sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URL=http://localhost:8088/auth/google/callback

# Admin account: created at startup if it doesn't exist. If the email belongs
# to an existing account (e.g. your Google login), that account is made admin
# and its password is left unchanged. Product limits and re-check intervals
# are managed in the admin dashboard (/admin), not here.
# ADMIN_EMAIL=admin@pricepulse.local
# ADMIN_PASSWORD=choose-a-long-random-password

# --- Email alerts (sent to each product owner) ---
# Leave SMTP_HOST empty to turn alerts off. For Gmail use smtp.gmail.com, port
# 587, and an app password (https://myaccount.google.com/apppasswords).
SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM="PricePulse <you@gmail.com>"

# --- Price scraper ---
# SCRAPER_ENABLED=true
# SCRAPE_POLL=1m
# SCRAPE_CONCURRENCY=4
